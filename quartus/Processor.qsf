# =============================================================================
# Processor.qsf  --  Quartus Prime Lite 16.1.0.196, Cyclone V 5CSEMA5F31C6
# Only project / file / device settings; every compiler setting is DEFAULT.
# =============================================================================
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY top_level
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 16.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "16.1.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name VHDL_FILE ../src/0.Package/cpu_pkg.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/memory_file.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/register_file.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/incrementer.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/sign_extend.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/alu.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/shifter.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/forwarding_unit.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/conditional_jump_decoder.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/ccr_register.vhd
set_global_assignment -name VHDL_FILE ../src/1.Components/stack_pointer.vhd
set_global_assignment -name VHDL_FILE ../src/2.PIPELINE_REGISTERS/IF_ID.vhd
set_global_assignment -name VHDL_FILE ../src/2.PIPELINE_REGISTERS/ID_EX1.vhd
set_global_assignment -name VHDL_FILE ../src/2.PIPELINE_REGISTERS/EX1_EX2.vhd
set_global_assignment -name VHDL_FILE ../src/2.PIPELINE_REGISTERS/EX2_MEM.vhd
set_global_assignment -name VHDL_FILE ../src/2.PIPELINE_REGISTERS/MEM_WB.vhd
set_global_assignment -name VHDL_FILE ../src/4.Controlling/Control_unit.vhd
set_global_assignment -name VHDL_FILE ../src/4.Controlling/hazard_unit.vhd
set_global_assignment -name VHDL_FILE ../src/4.Controlling/interrupt_unit.vhd
set_global_assignment -name VHDL_FILE ../src/3.Stages/FETCH.vhd
set_global_assignment -name VHDL_FILE ../src/3.Stages/DECODE.vhd
