eometry" /></mxCell><mxCell id="u37" value="m_ret" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=7;fontFamily=ui-monospace, monospace;fontColor=#C62828;labelBackgroundColor=#FFFFFF;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3308" y="663" width="28" height="10" as="geometry" /></mxCell><mxCell id="u38" value="m_rti" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=7;fontFamily=ui-monospace, monospace;fontColor=#1565C0;labelBackgroundColor=#FFFFFF;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3338" y="663" width="28" height="10" as="geometry" /></mxCell><mxCell id="u39" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=1;strokeColor=#000000;jumpStyle=arc;jumpSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3366" y="694" as="sourcePoint" /><mxPoint x="3366" y="648" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u40" value="clk" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=7;fontFamily=ui-monospace, monospace;fontColor=#000000;labelBackgroundColor=#FFFFFF;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3363.4" y="658.6" width="19.2" height="10" as="geometry" /></mxCell><mxCell id="u41" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=1;strokeColor=#000000;jumpStyle=arc;jumpSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3271" y="694" as="sourcePoint" /><mxPoint x="3271" y="648" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u42" value="RESET.IN" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=7;fontFamily=ui-monospace, monospace;fontColor=#000000;labelBackgroundColor=#FFFFFF;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3257.4" y="669.6" width="41.2" height="10" as="geometry" /></mxCell><mxCell id="u43" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B2DFDB;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="3881.5" y="607" width="127" height="39.5" as="geometry" /></mxCell><mxCell id="u44" value="rst" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=7;fontFamily=ui-monospace, monospace;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3887.55" y="609" width="16.9" height="10" as="geometry" /></mxCell><mxCell id="u45" value="" style="triangle;whiteSpace=wrap;html=1;direction=north;fillColor=#FFFFFF;strokeColor=#0E7C7B;" vertex="1" parent="1"><mxGeometry x="3938" y="636" width="14" height="12" as="geometry" /></mxCell><mxCell id="u46" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=1;strokeColor=#000000;jumpStyle=arc;jumpSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3945" y="694" as="sourcePoint" /><mxPoint x="3945" y="648" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u47" value="clk" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=7;fontFamily=ui-monospace, monospace;fontColor=#000000;labelBackgroundColor=#FFFFFF;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3942.4" y="658.6" width="19.2" height="10" as="geometry" /></mxCell><mxCell id="u48" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=1;strokeColor=#000000;jumpStyle=arc;jumpSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="3896" y="694" as="sourcePoint" /><mxPoint x="3896" y="648" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u49" value="RESET.IN" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=7;fontFamily=ui-monospace, monospace;fontColor=#000000;labelBackgroundColor=#FFFFFF;rotation=-90;" vertex="1" parent="1"><mxGeometry x="3882.4" y="669.6" width="41.2" height="10" as="geometry" /></mxCell><mxCell id="u50" value="Synchronous read: the address is sampled at the rising edge; the word is on q one cycle later.&lt;br&gt;Port A: pc[11:0] in IF → q_a in ID (q_a is the IF/ID.IR field, held when en_a = adv = 0).&lt;br&gt;Port B: addr_b in EX2 → q_b in MEM. A write (we_b = 1) happens at the edge that ends EX2." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=7;fontFamily=ui-monospace, monospace;fontColor=#880E4F;" vertex="1" parent="1"><mxGeometry x="1990" y="1590" width="540" height="34" as="geometry" /></mxCell><mxCell id="u51" value="write port: falling edge (~clk), in the middle of the WB cycle&lt;br&gt;read ports: combinational, value used in the 2nd half of ID" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=6.5;fontFamily=ui-monospace, monospace;fontColor=#BF360C;" vertex="1" parent="1"><mxGeometry x="1125" y="578" width="170" height="24" as="geometry" /></mxCell><mxCell id="u52" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#0E7C7B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="4110" y="60" width="660" height="1150" as="geometry" /></mxCell><mxCell id="u53" value="&lt;b&gt;Legend and conventions&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=16;fontFamily=ui-monospace, monospace;fontColor=#0E5A57;" vertex="1" parent="1"><mxGeometry x="4126" y="70" width="400" height="22" as="geometry" /></mxCell><mxCell id="u54" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="113" as="sourcePoint" /><mxPoint x="4200" y="113" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u55" value="32-bit data" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="106" width="520" height="14" as="geometry" /></mxCell><mxCell id="u56" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="133" as="sourcePoint" /><mxPoint x="4200" y="133" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u57" value="narrow data (addresses, register numbers, 16-bit imm)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="126" width="520" height="14" as="geometry" /></mxCell><mxCell id="u58" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=4;strokeColor=#1565C0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="153" as="sourcePoint" /><mxPoint x="4200" y="153" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u59" value="control word bus (control unit → ID/EX1)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="146" width="520" height="14" as="geometry" /></mxCell><mxCell id="u60" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=1.3;strokeColor=#1565C0;dashed=1;dashPattern=8 4 1 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="173" as="sourcePoint" /><mxPoint x="4200" y="173" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u61" value="control field carried in the pipeline registers" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="166" width="520" height="14" as="geometry" /></mxCell><mxCell id="u62" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=1.4;strokeColor=#C62828;dashed=1;dashPattern=8 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="193" as="sourcePoint" /><mxPoint x="4200" y="193" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u63" value="hazard / valid / interrupt control" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="186" width="520" height="14" as="geometry" /></mxCell><mxCell id="u64" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="213" as="sourcePoint" /><mxPoint x="4200" y="213" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u65" value="write-back and forwarding paths" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="206" width="520" height="14" as="geometry" /></mxCell><mxCell id="u66" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endSize=5;strokeWidth=1.6;strokeColor=#E65100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="233" as="sourcePoint" /><mxPoint x="4200" y="233" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u67" value="flags (carry, Z, N, C)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="226" width="520" height="14" as="geometry" /></mxCell><mxCell id="u68" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endSize=5;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="262" as="sourcePoint" /><mxPoint x="4200" y="262" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u69" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endSize=5;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4165" y="248" as="sourcePoint" /><mxPoint x="4165" y="276" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u70" value="crossing wires: the later wire jumps over (bump) — &lt;b&gt;not connected&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="255" width="520" height="14" as="geometry" /></mxCell><mxCell id="u71" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endSize=5;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4130" y="294" as="sourcePoint" /><mxPoint x="4200" y="294" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u72" style="edgeStyle=none;rounded=0;html=1;endArrow=none;endSize=5;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4165" y="294" as="sourcePoint" /><mxPoint x="4165" y="310" as="targetPoint" /></mxGeometry></mxCell><mxCell id="u73" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="4162" y="291" width="6" height="6" as="geometry" /></mxCell><mxCell id="u74" value="dot = junction, the wires &lt;b&gt;are connected&lt;/b&gt; (same signal)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="287" width="520" height="14" as="geometry" /></mxCell><mxCell id="u75" value="" style="triangle;whiteSpace=wrap;html=1;direction=north;fillColor=#FFFFFF;strokeColor=#0E7C7B;" vertex="1" parent="1"><mxGeometry x="4158" y="318" width="14" height="12" as="geometry" /></mxCell><mxCell id="u76" value="clock pin, rising edge.  &lt;b&gt;clk&lt;/b&gt; and &lt;b&gt;RESET.IN&lt;/b&gt; stubs are the single global clock and reset nets.&lt;br&gt;name[h:l] = the bits h..l of that signal;  ~clk = falling edge" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=9;fontFamily=ui-monospace, monospace;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4210" y="312" width="540" height="26" as="geometry" /></mxCell><mxCell id="u77" value="&lt;div style=&quot;font-weight:bold;color:#0E5A57;font-size:12px;margin-bottom:4px&quot;&gt;Clocking&lt;/div&gt;&lt;table width=&quot;620&quot; style=&quot;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Element&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Edge&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;PC, all pipeline registers, SP, CCR, shadow CCR, OUT, interrupt unit, RAM ports A and B&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;rising edge of clk&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;register file write port (WB)&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;falling edge of clk (~clk)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;everything else (ALU, muxes, decoders, hazard / forwarding units)&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;combinational&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=9;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4126" y="358" width="628" height="86" as="geometry" /></mxCell><mxCell id="u78" value="&lt;div style=&quot;font-weight:bold;color:#0E5A57;font-size:12px;margin-bottom:4px&quot;&gt;Pipeline register control inputs&lt;/div&gt;&lt;table width=&quot;620&quot; style=&quot;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Register&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Loads&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;valid / control bits&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;PC&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;en = adv, or a redirect (flush, m_ret, vec2)&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;rst: PC = 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IF/ID&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;load = adv (also RAM en_a, which holds IR = q_a)&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;valid: 0 on clear (ifid_clear = flush | m_ret | vec1 | vec2 | prep), 1 on load; rst: 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;ID/EX1&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;every cycle&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;valid_in = issue (0 = bubble); rst: valid = 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;EX1/EX2&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;every cycle&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;valid_in = e1_we = ID/EX1.valid &amp;amp; ¬flush (kills the EX1 instruction on a taken jump); rst: 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;EX2/MEM&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;every cycle&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;wr, memread, ret, rti = EX1/EX2 bit &amp;amp; EX1/EX2.valid (valid gating); rst: 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;MEM/WB&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;every cycle&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;wr = EX2/MEM.wr; rst: 0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;all&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;data fields have no reset&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;only valid / control bits are reset&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=9;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4126" y="458" width="628" height="170" as="geometry" /></mxCell><mxCell id="u79" value="&lt;div style=&quot;font-weight:bold;color:#0E5A57;font-size:12px;margin-bottom:4px&quot;&gt;Multiplexer select codes&lt;/div&gt;&lt;table width=&quot;620&quot; style=&quot;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Mux&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Select&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Input chosen&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;MUX PC&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;priority&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;flush → imm[15:0] (upper 16 bits 0) · m_ret → q_b · vec2 → q_a · adv → PC+1 · else hold&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IR&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;inj&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;0 → q_a[31:0] · 1 → INT 1 word (IMM = 1)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;RD2&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;pcB&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;0 → rd2[31:0] · 1 → pc[31:0] (return address)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;dst&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;destB&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;0 → IR[26:24] (D) · 1 → IR[20:18] (B, 2nd SWAP micro-op)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;Fwd A / Fwd B&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;fsA[1:0] / fsB[1:0]&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;00 → RD1/RD2 · 01 → E2.Res · 10 → MEM.Res · 11 → WB.Res&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;B Sel&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;bsel[1:0]&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;00 → fwdB · 01 → imm32 · 10 → IN.PORT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;Res&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;shift&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;0 → ALU[31:0] · 1 → SHF[31:0]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;addr B&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;stk&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;0 → EA[11:0] = Res[11:0] + imm[11:0] · 1 → SP[11:0] + pop&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;WB Sel&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;memread&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;0 → Res[31:0] · 1 → q_b[31:0]&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=9;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4126" y="642" width="628" height="190" as="geometry" /></mxCell><mxCell id="u80" value="&lt;div style=&quot;font-weight:bold;color:#0E5A57;font-size:12px;margin-bottom:4px&quot;&gt;Instruction-word fields&lt;/div&gt;&lt;table width=&quot;620&quot; style=&quot;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Field&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Bits&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Goes to&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;opcode&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IR[31:27]&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;control unit&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;D&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IR[26:24]&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;destination (write address), through the dst mux&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;A&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IR[23:21]&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;read port 1 → RD1 → Fwd A → ALU A / shifter / base address / OUT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;B&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IR[20:18]&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;read port 2 → RD2 → Fwd B → B Sel (ALU B) and store data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IMM&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IR[15:0]&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;immediate, offset, shift count, jump target, vector address&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=9;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="4126" y="846" width="628" height="110" as="geometry" /></mxCell><mxCell id="u81" value="&lt;div style=&quot;font-weight:bold;color:#0E5A57;font-size:12px;margin-bottom:4px&quot;&gt;Shared memory timing (synchronous read)&lt;/div&gt;&lt;table width=&quot;620&quot; style=&quot;border-collapse:collapse;font-size:9px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Port&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Address given in&lt;/th&gt;&lt;th style=&quot;background:#0E7C7B;color:#fff;padding:2px 5px;text-align:left&quot;&gt;Data valid in&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;A (fetch)&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;IF: pc[11:0], en_a = adv&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;ID: q_a = IF/ID.IR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;B (read: LDD, POP, RET, RTI)&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;EX2: addr_b[11:0]&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;MEM: q_b → MEM/WB (or PC for RET/RTI)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;B (write: STD, PUSH, CALL, INT)&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;EX2: addr_b, data_b, we_b&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;written at the edge ending EX2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;vectors (reset, INT, INTR)&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;PC = 0 / 1 / 2 / 3&lt;/td&gt;&lt;td style=&quot;border-top:1px solid #cfd8dc;padding:2px 5px;vertical-align:top&quot;&gt;next cycle q_a = M[vector] → PC (vec2)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontS