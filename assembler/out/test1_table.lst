000  00000010  10
010  90000001  LDM R0, 1        # R0 = 0000_0001
011  9100AAAA  LDM R1, AAAA     # R1 = 0000_AAAA   (LDM is zero-extended)
012  9200FFFF  LDM R2, FFFF     # R2 = 0000_FFFF
013  20000000  INC R0           # R0 = 0000_0002, Z,N,C = 0,0,0
014  3C040000  MOV R4, R1       # R4 = 0000_AAAA
015  19200000  NOT R1           # R1 = FFFF_5555, Z,N = 0,1
016  3B000000  MOV R3, R0       # R3 = 0000_0002
017  30000000  IN R0            # R0 = FFFF_FFFF
018  28000000  OUT R0           # OUT.PORT = FFFF_FFFF
019  5D200000  AND R5, R1, R0   # R5 = FFFF_5555, Z,N = 0,1
01A  3E000000  MOV R6, R0       # R6 = FFFF_FFFF
01B  1EC00000  NOT R6           # R6 = 0000_0000, Z,N = 1,0
01C  20000000  INC R0           # R0 = 0000_0000, Z,N,C = 1,0,1
01D  08000000  HLT
