400  18000000  NOT R0          # R0 = FFFFFFF9
401  20000000  INC R0          # Sets Negative Flag
402  B8000400  JC 400          #  |
403  B8000400  JC 400          #  |   Reducing the 2-bit branch predictor to 0
404  B8000400  JC 400          # \ /
405  B8000400  JC 400          #  '
406  20000000  INC R0
407  B0000406  JN 406          #  |   # Address of the INC # Loop until R0 is not negative (5 times), Increases the 2-bit branch predictor to max
408  B800040C  JC 40C          #  |
409  B800040C  JC 40C          #  |   Reducing the 2-bit branch predictor to 0
40A  B800040C  JC 40C          # \ /
40B  B800040C  JC 40C          #  '
40C  E0000000  RTI
